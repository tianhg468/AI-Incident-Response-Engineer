# Anthropic API
ANTHROPIC_API_KEY=your_api_key_here

# Mode: "live" for real MCP servers, "eval" for fixture-based mocks
MODE=eval

# Scenario (for eval mode)
SCENARIO=oom_after_deploy

# Checkpointing: "sqlite" for file-based (dev), "postgres" for production, "memory" for no persistence
CHECKPOINT_MODE=sqlite
CHECKPOINT_DB_PATH=./data/checkpoints.db

# Database (for postgres checkpointing in production)
DATABASE_URL=postgresql://user:password@localhost:5432/incident_response

# LangSmith (optional - for tracing)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGCHAIN_PROJECT=ai-incident-response

# Webhook
WEBHOOK_SECRET=your_webhook_secret_here
WEBHOOK_PORT=8000

# Slack (for approvals and notifications)
SLACK_BOT_TOKEN=xoxb-your-token-here
SLACK_CHANNEL=#incidents

# GitHub (for deploy correlation)
GITHUB_TOKEN=ghp_your_token_here
GITHUB_ORG=your_org

# Kubernetes
KUBECONFIG=~/.kube/config
K8S_NAMESPACE=default

# Observability (choose one)
# Grafana
GRAFANA_URL=http://localhost:3000
GRAFANA_API_KEY=your_grafana_key

# OR Datadog
# DATADOG_API_KEY=your_dd_key
# DATADOG_APP_KEY=your_dd_app_key

# OR Prometheus
# PROMETHEUS_URL=http://localhost:9090

# MCP Server Paths (for live mode)
MCP_K8S_SERVER=path/to/k8s-mcp-server
MCP_GITHUB_SERVER=path/to/github-mcp-server
MCP_SLACK_SERVER=path/to/slack-mcp-server
MCP_OBSERVABILITY_SERVER=path/to/observability-mcp-server
MCP_RUNBOOK_SERVER=./mcp_servers/runbook_correlator/server.py
